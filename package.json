{
  "name": "lp-kelka",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/generate-images.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json && tsc -p tsconfig.tests.json",
    "lint": "oxlint src scripts tests vite.config.ts playwright.config.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "npm run images && npm run typecheck && node scripts/build.mjs",
    "build:prod": "npm run build -- --release",
    "build:release": "npm run build -- --release",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview",
    "check:budgets": "node scripts/check-budgets.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^12.42.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "oxlint": "^1.69.0",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "tailwindcss": "^4.3.1",
    "@tailwindcss/vite": "^4.3.1",
    "@playwright/test": "^1.63.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20.19.0 <23",
    "npm": ">=10"
  }
}
